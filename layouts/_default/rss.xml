{{/* RSS feed kustom — dipakai feed pembaca (Feedly, Inoreader) dan layanan
     notifikasi email/push (follow.it) supaya pengikut dapat tulisan baru otomatis.

     Fokus ke tulisan blog + entri ber-tanggal (halaman buku tanpa tanggal
     dibuang, karena muncul sebagai 0001 di feed). Isi feed = konten utuh,
     bukan cuma potongan, jadi layanan email bisa mengirim tulisan lengkap. */}}
{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = where .Site.RegularPages "Type" "blog" -}}
{{- else -}}
  {{- $pages = .Pages -}}
{{- end -}}
{{- $pages = where $pages "Date" ">" (time "2000-01-01") -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ .Site.Title }} — tulisan baru{{ else }}{{ .Title }} — {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>id</language>
    <copyright>{{ .Site.Params.copyright }}</copyright>
    <lastBuildDate>{{ with index $pages 0 }}{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ else }}{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ end }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    {{- $hook := .Params.hook | default .Params.summary | default .Description | default .Summary }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ $hook | plainify | htmlUnescape }}</description>
      {{ with .Params.category }}<category>{{ . }}</category>{{ end }}
      <content:encoded>{{ .Content | html }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
